    "expo": "~55.0.28",
    "expo-apple-authentication": "~55.0.17",
    "expo-calendar": "~55.0.19",
    "expo-clipboard": "~55.0.15",
    "expo-constants": "~55.0.15",
    "expo-dev-client": "~55.0.41",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-localization": "~55.0.17",
    "expo-router": "~55.0.17",
    "expo-speech-recognition": "^58.0.0",
    "expo-status-bar": "~55.0.6",
