{
  "name": "famcal",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "artifact": "EXPO_PUBLIC_DEMO=1 expo export -p web && node scripts/web-single-file.js",
