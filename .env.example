# Copy to .env for the real app. Without these the app runs as the offline test link.
EXPO_PUBLIC_SUPABASE_URL=https://jzfubxcdpznzxqtvnodm.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable key aus Supabase, Project Settings, API Keys>
# Google Cloud, OAuth clients for FamCal: the Web client (also entered in Supabase) and the iOS client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<...>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<...>.apps.googleusercontent.com
# The phone test link (npm run artifact) always stays offline:
# EXPO_PUBLIC_DEMO=1
